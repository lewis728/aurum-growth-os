{
  "name": "aurum-growth-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "fire-lead": "tsx scripts/fire-test-lead.ts",
    "fire-postcall": "tsx scripts/fire-test-postcall.ts",
    "seed:verticals": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/seed-verticals.ts",
    "seed:decisions": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/seed-decision-library.ts",
    "onboard:research": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/onboard-research.ts",
    "onboard:provision": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/onboard-provision.ts",
    "onboard:deploy": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/onboard-deploy.ts",
    "onboard:apply": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/onboard-apply-research.ts",
    "leads:ch": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/companies-house-pull.ts",
    "leads:build": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs scripts/build-lead-list.ts",
    "train": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs src/lib/training/trainingRunner.ts",
    "train:quick": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/run-batch.cjs src/lib/training/trainingRunner.ts --quick",
    "train:estimate": "tsx src/lib/training/trainingRunner.ts --dry-run"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/pg": "^8.20.0",
    "lucide-react": "^1.17.0",
    "next": "14.2.35",
    "openai": "^6.39.1",
    "pg": "^8.21.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "swr": "^2.4.1",
    "twilio": "^6.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.28.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
