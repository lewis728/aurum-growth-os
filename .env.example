# ══════════════════════════════════════════════════════════════════════════════
# Aurum Growth OS — Environment Variable Registry
# Source of Truth: Master Implementation Guide Section 3
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Replace every REPLACE_ME value with your real credentials.
# 3. Never commit .env.local to version control.
# 4. Only NEXT_PUBLIC_APP_URL may carry the NEXT_PUBLIC_ prefix (GR-10).
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Required before Stage 02. Run: npx prisma migrate dev --name init
DATABASE_URL="postgresql://USER:REPLACE_ME@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:REPLACE_ME@HOST:PORT/DATABASE"

# ── Authentication (Clerk) ───────────────────────────────────────────────────
# Required before Stage 03.
# Get from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_REPLACE_ME"
CLERK_SECRET_KEY="sk_live_REPLACE_ME"

# ── AI (OpenAI) ──────────────────────────────────────────────────────────────
# Required before Stage 07.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-REPLACE_ME"

# ── Voice AI (Retell) ────────────────────────────────────────────────────────
# Required before Stage 05.
# Get from: https://app.retellai.com → Settings → API Keys
RETELL_API_KEY="key_REPLACE_ME"
RETELL_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ── Meta Ads (Graph API v20.0) ───────────────────────────────────────────────
# Required before Stage 05.
# Get from: https://business.facebook.com → Business Settings → System Users
META_ACCESS_TOKEN="EAAxxxx_REPLACE_ME"
META_AD_ACCOUNT_ID="act_REPLACE_ME"
META_PIXEL_ID="REPLACE_ME"
META_FACEBOOK_PAGE_ID="REPLACE_ME"
META_INSTAGRAM_ACTOR_ID="REPLACE_ME"

# ── Creative AI (Higgsfield) ─────────────────────────────────────────────────
# Required before Stage 05.
# Get from: https://app.higgsfield.ai → Settings → API
HIGGSFIELD_API_KEY="hf_REPLACE_ME"
HIGGSFIELD_API_URL="https://api.higgsfield.ai/v1"

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Required before Stage 04.
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID="ACREPLACE_ME"
TWILIO_AUTH_TOKEN="REPLACE_ME"
TWILIO_FROM_NUMBER="+1REPLACE_ME"
# WhatsApp sender (Sprint 10). Twilio WhatsApp number, e.g. "+447..." or the
# sandbox "+14155238886". The "whatsapp:" prefix is added in code. Falls back to
# TWILIO_FROM_NUMBER if unset.
TWILIO_WHATSAPP_FROM="+1REPLACE_ME"

# ── Lead enrichment (Sprint 10D, optional) ───────────────────────────────────
# If set, leadEnrichmentService calls the provider for company/role signals.
# Unset = local-only signals (corporate-domain + postcode); no-ops gracefully.
HUNTER_API_KEY=""
CLEARBIT_API_KEY=""

# ── Deployments (Vercel) ─────────────────────────────────────────────────────
# Required before Stage 05.
# Get from: https://vercel.com/account/tokens
VERCEL_API_TOKEN="REPLACE_ME"
VERCEL_TEAM_ID="team_REPLACE_ME"

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Required before Stage 04.
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ── Internal ─────────────────────────────────────────────────────────────────
# Required before Stage 08.
# Generate with: openssl rand -base64 32
CRON_SECRET="REPLACE_ME_min_32_chars_random_string"

# ── Cold-email outreach (Clay → app → Instantly) ─────────────────────────────
# Required to run the 6-niche outbound engine. Webhooks authenticate with
# OUTREACH_WEBHOOK_SECRET (Bearer). See docs/OUTREACH_SETUP.md.
OUTREACH_DEFAULT_TENANT="REPLACE_ME"          # your agency tenant id (Clay leads belong here)
OUTREACH_WEBHOOK_SECRET="REPLACE_ME_long_random_string"  # shared secret for Clay/Instantly webhooks
OUTREACH_OWNER_NAME="Lewis"                   # signs the emails ({{your_name}})
OUTREACH_OWNER_WHATSAPP="+44REPLACE_ME"       # E.164 — where reply pings/digests go
OUTREACH_CALENDLY_LINK=""                     # booking link (only used if auto-reply is on)
# Auto-reply is OFF by default — replies are forwarded to you to handle yourself.
# Set to "true" ONLY when you want the bot to send replies again.
OUTREACH_AUTO_REPLY="false"

# ── Sending (Instantly) ──────────────────────────────────────────────────────
# Instantly owns sending domains, warmup, daily limits, cadence + follow-up steps.
# Get from: Instantly → Settings → API, and the campaign URL.
INSTANTLY_API_KEY="REPLACE_ME"
INSTANTLY_CAMPAIGN_ID="REPLACE_ME"

# ── Email verification (brutal bounce protection) ────────────────────────────
# When set, EVERY address is verified before send and only a clean "valid" is sent
# (catch-all/risky/invalid/unknown are parked). Unset = rely on Clay's verification
# + the role-inbox guard. Provider: "millionverifier" (default).
OUTREACH_VERIFIER="millionverifier"
MILLIONVERIFIER_API_KEY=""

# ── Lead-list building (npm run leads:build — find/enrich/verify the market) ─
# SOURCE the universe (Google Maps via Outscraper → name/website/phone/reviews).
LEAD_SOURCE_PROVIDER="outscraper"
OUTSCRAPER_API_KEY=""                                # https://outscraper.com (paid per result)
# FIND the owner email (waterfall, role-guarded). Findymail or Hunter.
LEAD_EMAIL_FINDER="findymail"                        # findymail | hunter
FINDYMAIL_API_KEY=""                                 # https://findymail.com
# (HUNTER_API_KEY is defined above under Lead enrichment — reused if LEAD_EMAIL_FINDER=hunter)
# VERIFY: MILLIONVERIFIER_API_KEY (defined below) gates only clean 'valid' through.

# ── Client onboarding (terminal skill: /onboard-client) ──────────────────────
# The tenant new clients are created under, and the PROD app URL the landing/ad
# links point at (so onboarding never bakes in a localhost URL).
ONBOARD_TENANT=""                                   # falls back to OUTREACH_DEFAULT_TENANT / latest blueprint
ONBOARD_APP_URL="https://aurum-growth-os.vercel.app"

# ── Live web research (Marcus "instantly researches why" — godlike layer) ────
# When set, Marcus researches the real world (storms/competitor promos/news) to
# explain a CPL/CTR anomaly BEFORE acting. Graceful: unset = he reasons without it.
WEB_SEARCH_PROVIDER="serper"                        # serper | tavily
SERPER_API_KEY=""                                    # https://serper.dev
TAVILY_API_KEY=""                                    # alternative provider

# ── App URL ──────────────────────────────────────────────────────────────────
# The ONLY permitted NEXT_PUBLIC_ variable (GR-10).
# Set to your Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
